RewriteEngine On

# Never serve dotfiles or hidden configuration directories. Keep ACME and
# other standards-based well-known endpoints available when explicitly used.
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L,NC]

# Internal PHP files are implementation details.  They must only be reached
# through the front controller (or an explicitly public endpoint), while still
# remaining includable by PHP.  These rules work with Apache and LiteSpeed.
RewriteRule ^(?:views|connection|inc|database|scripts|vendor)/.*\.php$ - [R=404,L,NC]
RewriteRule ^storage/private(?:/|$) - [R=404,L,NC]
RewriteRule ^(?:__init|composer|phpunit)\.php$ - [R=404,L,NC]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . index.php [L]
php_value upload_max_filesize 5G
php_value post_max_size 5G
php_value max_input_time 10800
php_value max_execution_time 10800
