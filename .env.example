# Absolute private path outside the public web root. Do not commit the JSON credential.
MMH_GOOGLE_SERVICE_ACCOUNT_JSON=

# Fawaterak credentials (rotate any previously committed values before use).
FAWATERAK_API_KEY=
FAWATERAK_VENDOR_KEY=

# Password reset delivery (Resend). Keep the API key in the server environment.
RESEND_API_KEY=
MAIL_FROM_EMAIL=no-reply@mathmasteryhub.com
MAIL_FROM_NAME=Math Mastery Hub
APP_PUBLIC_URL=https://mathmasteryhub.com
